<% customers/show.html.erb %>

<h1><%= @customer.name %></h1>

<dl class="row">
  <dt class="col-sm-3">Name</dt>
  <dd class="col-sm-9"><%= @customer.name %></dd>

  <dt class="col-sm-3">Phone</dt>
  <dd class="col-sm-9"><%= @customer.phone %></dd>
</dl>

<h2>Bikes</h2>

<% if @bikes.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Make</th>
        <th>Model</th>
        <th>Colour</th>
        <th>Serial Number</th>
        <th>Owner</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% else %>
  <p>This customer has no bikes.</p>
<% end %>

<%= link_to "Back to Customers", customers_path, class: "btn btn-secondary" %>