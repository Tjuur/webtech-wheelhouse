<% content_for :title, @staff_member.name %>

<h1><%= @staff_member.name %></h1>

<dl class="row">
  <dt class="col-sm-3">Name</dt>
  <dd class="col-sm-9"><%= @staff_member.name %></dd>

  <dt class="col-sm-3">Role</dt>
  <dd class="col-sm-9"><%= @staff_member.role %></dd>
</dl>

<h2>Repairs</h2>

<% if @staff_member.repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Customer</th>
        <th>Status</th>
        <th>Promised Date</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <%= render @staff_member.repairs %>
    </tbody>
  </table>
<% else %>
  <p>This staff member has no assigned repairs.</p>
<% end %>

<%= link_to "Back to Staff", staff_index_path, class: "btn btn-secondary" %>