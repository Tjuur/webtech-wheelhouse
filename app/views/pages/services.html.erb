<h1>Services</h1>

<p>Wheelhouse offers a range of bicycle repair services. Current prices are listed below.</p>

<table class="table">
  <thead>
    <tr>
      <th>Service</th>
      <th>Price</th>
    </tr>
  </thead>

  <tbody>
    <% @services.each do |service| %>
      <tr>
        <td><%= service[:name] %></td>
        <td>$<%= service[:price] %></td>
      </tr>
    <% end %>
  </tbody>
</table>