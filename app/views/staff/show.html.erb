<% content_for :title, @staff_member.name %>

<h1><%= @staff_member.name %></h1>

<dl class="row">
	<dt class="col-sm-3">Role</dt>
	<dd class="col-sm-9"><%= @staff_member.role %></dd>
</dl>

<h2>Repairs</h2>

<% if @repairs.any? %>
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Repair</th>
				<th>Bike</th>
				<th>Customer</th>
				<th>Status</th>
				<th>Promised Date</th>
			</tr>
		</thead>
		<tbody>
			<% @repairs.each do |repair| %>
				<tr>
					<td>
						<%= link_to "Repair ##{repair.id}", repair_path(repair) %>
					</td>
					<td>
						<%= link_to "#{repair.bike.make} #{repair.bike.model}",
							bike_path(repair.bike) %>
					</td>
					<td>
						<%= link_to repair.bike.customer.name,
							customer_path(repair.bike.customer) %>
					</td>
					<td><%= repair.status %></td>
					<td>
						<%= repair.promised_on&.strftime("%d %b %Y") || "Not set" %>
					</td>
				</tr>
			<% end %>
		</tbody>
	</table>
<% else %>
	<p>This staff member has no assigned repairs.</p>
<% end %>

<div class="d-flex gap-2 mt-3">
	<%= link_to "Edit Staff Member",
		edit_staff_path(@staff_member),
		class: "btn btn-primary" %>

	<%= button_to "Delete Staff Member",
		staff_path(@staff_member),
		method: :delete,
		class: "btn btn-danger",
		form: {
			data: {
				turbo_confirm: "Delete staff member #{@staff_member.name}?"
			}
		} %>

	<%= link_to "Back to Staff",
		staff_index_path,
		class: "btn btn-secondary" %>
</div>