<% content_for :title, "#{@bike.make} #{@bike.model}" %>

<h1><%= @bike.make %> <%= @bike.model %></h1>

<dl class="row">
	<dt class="col-sm-3">Customer</dt>
	<dd class="col-sm-9">
		<%= link_to @bike.customer.name, customer_path(@bike.customer) %>
	</dd>

	<dt class="col-sm-3">Make</dt>
	<dd class="col-sm-9"><%= @bike.make %></dd>

	<dt class="col-sm-3">Model</dt>
	<dd class="col-sm-9"><%= @bike.model %></dd>

	<dt class="col-sm-3">Colour</dt>
	<dd class="col-sm-9"><%= @bike.colour %></dd>

	<dt class="col-sm-3">Serial Number</dt>
	<dd class="col-sm-9"><%= @bike.serial_number %></dd>
</dl>

<h2>Repairs</h2>

<%= link_to "Add Repair",
	new_repair_path(bike_id: @bike.id),
	class: "btn btn-primary mb-3" %>

<% if @repairs.any? %>
	<table class="table table-striped align-middle">
		<thead>
			<tr>
				<th>Photo</th>
				<th>Bike</th>
				<th>Customer</th>
				<th>Status</th>
				<th>Diagnosis</th>
				<th>Promised Date</th>
				<th></th>
			</tr>
		</thead>

		<tbody>
			<%= render @repairs %>
		</tbody>
	</table>
<% else %>
	<p>This bike has no repairs.</p>
<% end %>

<div class="d-flex gap-2 mt-3">
	<%= link_to "Edit Bike",
		edit_bike_path(@bike),
		class: "btn btn-primary" %>

	<%= button_to "Delete Bike",
		bike_path(@bike),
		method: :delete,
		class: "btn btn-danger",
		form: {
			data: {
				turbo_confirm: "Delete bike #{@bike.serial_number}?"
			}
		} %>

	<%= link_to "Back to Bikes",
		bikes_path,
		class: "btn btn-secondary" %>
</div>