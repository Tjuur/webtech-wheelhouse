<%= form_with model: customer do |form| %>
	<% if customer.errors.any? %>
		<div class="alert alert-danger" role="alert">
			<h2 class="h5">Please correct the following errors:</h2>
			<ul class="mb-0">
				<% customer.errors.full_messages.each do |message| %>
					<li><%= message %></li>
				<% end %>
			</ul>
		</div>
	<% end %>

	<div class="mb-3">
		<%= form.label :name, class: "form-label" %>
		<%= form.text_field :name,
			class: "form-control #{'is-invalid' if customer.errors[:name].any?}" %>

		<% customer.errors.full_messages_for(:name).each do |message| %>
			<div class="invalid-feedback"><%= message %></div>
		<% end %>
	</div>

	<div class="mb-3">
		<%= form.label :phone, class: "form-label" %>
		<%= form.text_field :phone,
			class: "form-control #{'is-invalid' if customer.errors[:phone].any?}" %>

		<% customer.errors.full_messages_for(:phone).each do |message| %>
			<div class="invalid-feedback"><%= message %></div>
		<% end %>
	</div>

	<div class="d-flex gap-2">
		<%= form.submit class: "btn btn-primary" %>

		<%= link_to "Cancel",
			customer.persisted? ? customer_path(customer) : customers_path,
			class: "btn btn-secondary" %>
	</div>
<% end %>