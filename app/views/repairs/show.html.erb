<% content_for :title, "Repair ##{@repair.id}" %>

<h1>Repair #<%= @repair.id %></h1>

<dl class="row">
	<dt class="col-sm-3">Bike</dt>
	<dd class="col-sm-9">
		<%= link_to "#{@repair.bike.make} #{@repair.bike.model}", bike_path(@repair.bike) %>
	</dd>

	<dt class="col-sm-3">Customer</dt>
	<dd class="col-sm-9">
		<%= link_to @repair.bike.customer.name, customer_path(@repair.bike.customer) %>
	</dd>

	<dt class="col-sm-3">Staff</dt>
	<dd class="col-sm-9">
		<% if @repair.staff.present? %>
			<%= link_to @repair.staff.name, staff_path(@repair.staff) %>
		<% else %>
			Not assigned
		<% end %>
	</dd>

	<dt class="col-sm-3">Status</dt>
	<dd class="col-sm-9"><%= @repair.status %></dd>

	<dt class="col-sm-3">Approval Status</dt>
	<dd class="col-sm-9"><%= @repair.approval_status || "Not set" %></dd>

	<dt class="col-sm-3">Promised Date</dt>
	<dd class="col-sm-9">
		<%= @repair.promised_on&.strftime("%d %b %Y") || "Not set" %>
	</dd>

	<dt class="col-sm-3">Quoted At</dt>
	<dd class="col-sm-9">
		<%= @repair.quoted_at&.strftime("%d %b %Y, %H:%M") || "Not quoted" %>
	</dd>

	<dt class="col-sm-3">Handed Back At</dt>
	<dd class="col-sm-9">
		<%= @repair.handed_back_at&.strftime("%d %b %Y, %H:%M") || "Not handed back" %>
	</dd>
</dl>

<h2>Diagnosis</h2>

<% if @repair.diagnosis.present? %>
	<div class="mb-4">
		<%= @repair.diagnosis %>
	</div>
<% else %>
	<p>No diagnosis has been recorded.</p>
<% end %>

<h2>Intake Photos</h2>

<% if @repair.intake_photos.attached? %>
	<div class="row g-3 mb-4">
		<% @repair.intake_photos.each do |photo| %>
			<div class="col-md-6 col-lg-4">
				<div class="card h-100">
					<%= link_to url_for(photo), target: "_blank" do %>
						<%= image_tag photo.variant(:display),
							alt: "#{@repair.bike.make} #{@repair.bike.model}, repair ##{@repair.id} intake photo",
							class: "card-img-top img-fluid" %>
					<% end %>

					<div class="card-body">
						<%= button_to "Remove Photo",
							repair_intake_photo_path(@repair, attachment_id: photo.id),
							method: :delete,
							class: "btn btn-outline-danger btn-sm",
							form: {
								data: {
									turbo_confirm: "Remove this intake photo?"
								}
							} %>
					</div>
				</div>
			</div>
		<% end %>
	</div>
<% else %>
	<p>No intake photos have been uploaded.</p>
<% end %>

<h2>Services</h2>

<% if @repair_services.any? %>
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Service</th>
				<th>Charged Price</th>
			</tr>
		</thead>

		<tbody>
			<% @repair_services.each do |repair_service| %>
				<tr>
					<td>
						<%= link_to repair_service.service.name,
							service_path(repair_service.service) %>
					</td>
					<td>
						<%= number_to_currency(repair_service.charged_price) %>
					</td>
				</tr>
			<% end %>
		</tbody>

		<tfoot>
			<tr>
				<th>Total</th>
				<th><%= number_to_currency(@repair.total) %></th>
			</tr>
		</tfoot>
	</table>
<% else %>
	<p>No services have been charged to this repair.</p>
<% end %>

<div class="d-flex gap-2 mt-3">
	<%= link_to "Edit Repair",
		edit_repair_path(@repair),
		class: "btn btn-primary" %>

	<%= button_to "Delete Repair",
		repair_path(@repair),
		method: :delete,
		class: "btn btn-danger",
		form: {
			data: {
				turbo_confirm: "Delete repair ##{@repair.id}?"
			}
		} %>

	<%= link_to "Back to Repairs",
		repairs_path,
		class: "btn btn-secondary" %>
</div>