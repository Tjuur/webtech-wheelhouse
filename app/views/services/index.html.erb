<h1>Services</h1>

<% if @services.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Service</th>
        <th>Current Price</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @services.each do |service| %>
        <tr>
          <td><%= service.name %></td>
          <td><%= number_to_currency(service.current_price) %></td>
          <td>
            <%= link_to "View", service_path(service), class: "btn btn-primary btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No services found.</p>
<% end %>