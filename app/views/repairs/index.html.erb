<%= link_to "New Repair", new_repair_path, class: "btn btn-primary mb-3" %>

<h1>Repairs</h1>

<% if @repairs.any? %>
	<table class="table table-striped align-middle">
		<thead>
			<tr>
				<th>Photo</th>
				<th>Bike</th>
				<th>Customer</th>
				<th>Status</th>
				<th>Diagnosis</th>
				<th>Promised Date</th>
				<th></th>
			</tr>
		</thead>

		<tbody>
			<%= render @repairs %>
		</tbody>
	</table>
<% else %>
	<p>No repairs found.</p>
<% end %>