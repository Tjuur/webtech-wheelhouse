<% content_for :title, @service.name %>

<h1><%= @service.name %></h1>

<dl class="row">
  <dt class="col-sm-3">Current Price</dt>
  <dd class="col-sm-9">
    <%= number_to_currency(@service.current_price) %>
  </dd>
</dl>

<% if policy(@service).view_repair_history? %>
  <h2>Repair History</h2>

  <% if @repair_services.any? %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Repair</th>
          <th>Bike</th>
          <th>Charged Price</th>
        </tr>
      </thead>

      <tbody>
        <% @repair_services.each do |repair_service| %>
          <% repair = repair_service.repair %>

          <tr>
            <td>
              <% if policy(repair).show? %>
                <%= link_to "Repair ##{repair.id}",
                  repair_path(repair) %>
              <% else %>
                Repair #<%= repair.id %>
              <% end %>
            </td>

            <td>
              <% if policy(repair.bike).show? %>
                <%= link_to "#{repair.bike.make} #{repair.bike.model}",
                  bike_path(repair.bike) %>
              <% else %>
                <%= "#{repair.bike.make} #{repair.bike.model}" %>
              <% end %>
            </td>

            <td>
              <%= number_to_currency(repair_service.charged_price) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>This service has not been used on any repairs you can access.</p>
  <% end %>
<% end %>

<div class="d-flex gap-2 mt-3">
  <% if policy(@service).update? %>
    <%= link_to "Edit Service",
      edit_service_path(@service),
      class: "btn btn-primary" %>
  <% end %>

  <% if policy(@service).destroy? %>
    <%= button_to "Delete Service",
      service_path(@service),
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "Delete service #{@service.name}?"
        }
      } %>
  <% end %>

  <%= link_to "Back to Services",
    services_path,
    class: "btn btn-secondary" %>
</div>