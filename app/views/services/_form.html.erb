<%= form_with model: service do |form| %>
	<% if service.errors.any? %>
		<div class="alert alert-danger" role="alert">
			<h2 class="h5">Please correct the following errors:</h2>
			<ul class="mb-0">
				<% service.errors.full_messages.each do |message| %>
					<li><%= message %></li>
				<% end %>
			</ul>
		</div>
	<% end %>

	<div class="mb-3">
		<%= form.label :name, class: "form-label" %>
		<%= form.text_field :name,
			class: "form-control #{'is-invalid' if service.errors[:name].any?}" %>

		<% service.errors.full_messages_for(:name).each do |message| %>
			<div class="invalid-feedback"><%= message %></div>
		<% end %>
	</div>

	<div class="mb-3">
		<%= form.label :current_price, "Current Price", class: "form-label" %>
		<%= form.number_field :current_price,
			step: "0.01",
			class: "form-control #{'is-invalid' if service.errors[:current_price].any?}" %>

		<% service.errors.full_messages_for(:current_price).each do |message| %>
			<div class="invalid-feedback"><%= message %></div>
		<% end %>
	</div>

	<div class="d-flex gap-2">
		<%= form.submit class: "btn btn-primary" %>

		<%= link_to "Cancel",
			service.persisted? ? service_path(service) : services_path,
			class: "btn btn-secondary" %>
	</div>
<% end %>