<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Webtech Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
      <div class="container">

        <% if authenticated? %>
          <%= link_to "Wheelhouse", root_path, class: "navbar-brand" %>
        <% else %>
          <%= link_to "Wheelhouse", services_path, class: "navbar-brand" %>
        <% end %>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
          aria-controls="mainNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto align-items-lg-center">

            <% if authenticated? %>

              <li class="nav-item">
                <%= link_to "Home", root_path,
                    class: "nav-link #{'active' if current_page?(root_path)}" %>
              </li>

              <li class="nav-item">
                <%= link_to "Customers", customers_path,
                    class: "nav-link #{'active' if controller_name == 'customers'}" %>
              </li>

              <li class="nav-item">
                <%= link_to "Bikes", bikes_path,
                    class: "nav-link #{'active' if controller_name == 'bikes'}" %>
              </li>

              <li class="nav-item">
                <%= link_to "Repairs", repairs_path,
                    class: "nav-link #{'active' if controller_name == 'repairs'}" %>
              </li>

              <li class="nav-item">
                <%= link_to "Services", services_path,
                    class: "nav-link #{'active' if controller_name == 'services'}" %>
              </li>

              <li class="nav-item">
                <%= link_to "Staff", staff_index_path,
                    class: "nav-link #{'active' if controller_name == 'staff'}" %>
              </li>

              <li class="nav-item">
                <%= link_to "Visit", visit_path,
                    class: "nav-link #{'active' if current_page?(visit_path)}" %>
              </li>

              <li class="nav-item">
                <%= link_to "About", about_path,
                    class: "nav-link #{'active' if current_page?(about_path)}" %>
              </li>

              <li class="nav-item ms-lg-3">
                <span class="nav-link text-body-secondary">
                  <strong><%= Current.user.staff&.name || Current.user.email_address %></strong>
                  <span class="badge bg-secondary">
                    <%= Current.user.role.humanize %>
                  </span>
                </span>
              </li>

              <li class="nav-item ms-lg-2">
                <%= button_to "Log out",
                    session_path,
                    method: :delete,
                    class: "btn btn-outline-danger btn-sm" %>
              </li>

            <% else %>

              <li class="nav-item">
                <%= link_to "Services", services_path,
                    class: "nav-link #{'active' if controller_name == 'services'}" %>
              </li>

              <li class="nav-item ms-lg-3">
                <%= link_to "Sign in",
                    new_session_path,
                    class: "btn btn-primary btn-sm" %>
              </li>

            <% end %>

          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% flash.each do |type, message| %>
        <% bootstrap_class = type == "notice" ? "alert-success" : "alert-danger" %>

        <div class="alert <%= bootstrap_class %>" role="alert">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>